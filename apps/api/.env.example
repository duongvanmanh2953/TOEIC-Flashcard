# ==============================================================================
# VOCABFLOW AI - BACKEND API ENVIRONMENT VARIABLES REFERENCE (.env.example)
# ==============================================================================
# LƯU Ý: Dự án sử dụng 1 file .env DUY NHẤT đặt tại thư mục gốc của repository:
#   ../../.env
# Các biến dưới đây đã được cấu hình trong file .env gốc. File này chỉ dùng để
# tham khảo các biến dành riêng cho Backend API.
# ==============================================================================

PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leximind_db?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET="leximind_jwt_super_secure_access_token_secret_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="leximind_jwt_super_secure_refresh_token_secret_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# AI Integration
AI_PROVIDER="auto"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# SMTP Mailer
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="VocabFlow <onboarding@resend.dev>"
