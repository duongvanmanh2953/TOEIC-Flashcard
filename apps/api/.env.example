# Server Environment
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leximind_db?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET="leximind_jwt_super_secure_access_token_secret_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="leximind_jwt_super_secure_refresh_token_secret_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis Cache (Optional for dev fallback)
REDIS_URL="redis://localhost:6379"

# AI Integration (OpenAI / Gemini / Anthropic)
AI_PROVIDER="mock" # Set to 'openai' or 'gemini' when production API keys are provided
OPENAI_API_KEY=""
GEMINI_API_KEY=""
