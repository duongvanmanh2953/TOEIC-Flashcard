# ==============================================================================
# VOCABFLOW AI - FRONTEND WEB ENVIRONMENT VARIABLES REFERENCE (.env.example)
# ==============================================================================
# LƯU Ý: Dự án sử dụng 1 file .env DUY NHẤT đặt tại thư mục gốc của repository:
#   ../../.env
# Vite đã được cấu hình envDir trỏ về thư mục gốc, tự động nạp các biến VITE_*
# từ file .env gốc. File này chỉ dùng để tham khảo các biến của Frontend Web.
# ==============================================================================

# API Base URL
VITE_API_BASE_URL=http://localhost:4000/api

# Firebase Authentication & Social Login
# Lấy từ Firebase Console -> Project Settings -> General -> Your apps -> Web app
# Hoặc cấu hình trực tiếp trong app tại Admin Dashboard (/admin/firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
