{
  "name": "vocabflow-ai",
  "version": "1.0.0",
  "description": "VocabFlow AI — Advanced English Vocabulary Learning Platform with Spaced Repetition & AI Tutor",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:api": "npm --workspace=apps/api run start:dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "npm run build --workspaces",
    "build:apk": "./scripts/build-apk.sh",
    "build:ios": "./scripts/build-ios.sh",
    "prisma:generate": "npm --workspace=apps/api run prisma:generate",
    "prisma:migrate": "npm --workspace=apps/api run prisma:migrate",
    "prisma:seed": "npm --workspace=apps/api run prisma:seed",
    "admin:reset": "npx ts-node apps/api/updateAdminPass.ts"
  },
  "keywords": [
    "vocabflow",
    "vocabulary",
    "spaced-repetition",
    "nestjs",
    "react",
    "toeic",
    "english-learning"
  ],
  "author": "VocabFlow Team",
  "license": "MIT",
  "dependencies": {
    "@k1low/kakitori": "^0.21.0",
    "hanzi-writer": "^3.7.3",
    "iink-ts": "^4.1.0"
  }
}
