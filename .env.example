# ==============================================================================
# VOCABFLOW AI / LEXIMIND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy file này thành .env tại thư mục gốc của project:
#   cp .env.example .env
# Duy nhất 1 file .env chung cho toàn bộ dự án (Backend API, Frontend Web, Docker)
# KHÔNG COMMIT FILE .env LÊN GIT!
# ==============================================================================

# Server & Network Configuration
PORT=4000
NODE_ENV=production
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=leximind_db
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/leximind_db?schema=public

# Redis In-Memory Cache & Session Store
REDIS_URL=redis://redis:6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Bootstrap Account (Created during initial seed)
INITIAL_ADMIN_EMAIL=admin@leximind.ai
INITIAL_ADMIN_PASSWORD=admin123

# External AI Provider Keys (Gemini, OpenAI, DeepSeek, Anthropic)
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# VietQR Payment Configuration (Tài khoản ngân hàng nhận chuyển khoản bảo mật)
VIETQR_BANK_ID=VCB
VIETQR_ACCOUNT_NO=9353421340
VIETQR_ACCOUNT_NAME=DUONG VAN MANH
VIETQR_TEMPLATE=compact2

# Payment Webhook (PayOS / SePay Gateway)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION (Resend SMTP Gateway via Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="VocabFlow <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# FRONTEND CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api

# FIREBASE CLIENT AUTHENTICATION (Google OAuth / Facebook OAuth)
# Lấy từ Firebase Console -> Project Settings -> General -> Your apps -> Web app
# Hoặc cấu hình trực tiếp trong Admin Dashboard (/admin/firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
