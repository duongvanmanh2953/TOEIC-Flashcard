# ==============================================================================
# LexiMind AI — Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Port
PORT=4000
NODE_ENV=production

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=leximind_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Cache & Sessions (Redis)
REDIS_URL=redis://redis:6379

# JWT Authentication Secrets (Generate secure random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# Admin Initialization Bootstrap (Used only on initial seed)
INITIAL_ADMIN_EMAIL=admin@leximind.ai
INITIAL_ADMIN_PASSWORD=change_this_admin_password

# External AI Provider Keys (Optional: OpenAI, Groq, DeepSeek, or Anthropic)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# OAuth Social Login (Optional: Google & Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ==============================================================================
# Payment Configuration (VietQR & Webhook Gateways)
# ==============================================================================
# Cấu hình tài khoản ngân hàng nhận chuyển khoản VietQR tự động
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0388888888
VIETQR_ACCOUNT_NAME=LEXIMIND VOCABFLOW
VIETQR_TEMPLATE=compact2

# Cổng thanh toán trực tuyến PayOS (Truyền API key sau khi đăng ký payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Khóa bí mật xác thực Webhook chung (Dùng cho SePay / Casso / Custom Webhook)
PAYMENT_WEBHOOK_SECRET=

