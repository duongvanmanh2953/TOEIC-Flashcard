# ==============================================================================
# VOCABFLOW AI / VOCABFLOW - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy file này thành .env tại thư mục gốc của project:
#   cp .env.example .env
# Duy nhất 1 file .env chung cho toàn bộ dự án (Backend API, Frontend Web, Docker)
# KHÔNG COMMIT FILE .env LÊN GIT!
# ==============================================================================

# Server & Network Configuration
PORT=4000
NODE_ENV=production
APP_URL=https://app-api.vocalflow.site
CLIENT_URL=https://app.vocalflow.site

# Domain Specific URLs
STUDENT_API_URL=https://app-api.vocalflow.site
STUDENT_CLIENT_URL=https://app.vocalflow.site
KID_API_URL=https://kid-api.vocalflow.site
KID_CLIENT_URL=https://kid.vocalflow.site
ADMIN_API_URL=https://admin-api.vocalflow.site
ADMIN_CLIENT_URL=https://admin.vocalflow.site
ASSETS_URL=https://assets.vocalflow.site

# Frontend Client API Endpoints (Vite build-time)
VITE_STUDENT_API_BASE_URL=https://app-api.vocalflow.site/api
VITE_KID_API_BASE_URL=https://kid-api.vocalflow.site/api
VITE_ADMIN_API_BASE_URL=https://admin-api.vocalflow.site/api
VITE_ASSETS_BASE_URL=https://assets.vocalflow.site

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=vocabflow_db
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/vocabflow_db?schema=public

# Redis In-Memory Cache & Session Store
REDIS_URL=redis://redis:6379

# RabbitMQ High-Availability Message Broker & Worker Queue
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d

# Server Master Password (Required for maintenance scripts like yarn admin:reset)
SERVER_MASTER_PASSWORD="VocabFlowMaster2026"

# Initial Admin Bootstrap Account (Created during initial seed)
INITIAL_ADMIN_EMAIL=admin@vocabflow.ai
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_LEARNER_PASSWORD=password123

# External AI Provider Keys (Gemini, OpenAI, DeepSeek, Anthropic)
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# VietQR Payment Configuration (Tài khoản ngân hàng nhận chuyển khoản bảo mật)
VIETQR_BANK_ID=VCB
VIETQR_ACCOUNT_NO=9353421340
VIETQR_ACCOUNT_NAME=DUONG VAN MANH
VIETQR_TEMPLATE=compact2

# Payment Webhook (PayOS / SePay Gateway)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION (Resend SMTP Gateway via Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="VocabFlow <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# FRONTEND CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api

# FIREBASE CLIENT AUTHENTICATION (Google OAuth / Facebook OAuth)
# Lấy từ Firebase Console -> Project Settings -> General -> Your apps -> Web app
# Hoặc cấu hình trực tiếp trong Admin Dashboard (/admin/firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# THÔNG TIN PHÁP LÝ & CHỦ SỞ HỮU WEBSITE (THÔNG BÁO BỘ CÔNG THƯƠNG - NĐ 52/2013)
# ------------------------------------------------------------------------------
# Tên cá nhân hoặc tổ chức sở hữu website (Bắt buộc)
VITE_LEGAL_OWNER_NAME=
# Địa chỉ liên hệ / trụ sở của chủ sở hữu (Bắt buộc)
VITE_LEGAL_OWNER_ADDRESS=
# Số điện thoại liên hệ chính thức (Bắt buộc)
VITE_LEGAL_OWNER_PHONE=
# Email tiếp nhận liên hệ & giải quyết khiếu nại (Bắt buộc)
VITE_LEGAL_OWNER_EMAIL=support@vocalflow.site
# Mã số thuế doanh nghiệp hoặc cá nhân (nếu thuộc đối tượng phải có)
VITE_LEGAL_OWNER_TAX_CODE=
# Người đại diện pháp luật (đối với doanh nghiệp)
VITE_LEGAL_REPRESENTATIVE=

# ------------------------------------------------------------------------------
# REALTIME WEBSOCKET & MULTI-PORT SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
VITE_WS_URL=https://app-api.vocalflow.site
COOKIE_DOMAIN=.vocalflow.site
KID_PORT=4100
ADMIN_PORT=4200

